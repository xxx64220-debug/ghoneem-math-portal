[{"id":"015afa55-5485-5f8e-8925-5d6abe52776f","track_id":"act2","topic":"Volume and surface area","difficulty":"medium","type":"mcq","stem":"A right cylinder has radius-to-height ratio $5:7$ and volume 550. Using $\\pi=22/7$, what is its radius?","choices":[{"key":"A","text":"$\\sqrt5$"},{"key":"B","text":"5"},{"key":"C","text":"7"},{"key":"D","text":"$\\sqrt7$"}],"assets":{"source_code":"ACT2-IMPORT-20261030-D20-P070-Q167","source_page":70,"import_batch":"20261030-act2-question-import","source_sha256":"8ce5beb14b467975033df76f60552d85ae78e7737822f804ea070cccad9569d2","content_origin":"source_transcription","content_review":{"method":"Visual source check, independent mathematical solution, answer-choice match and duplicate review.","status":"verified"},"source_section":"Scanned questions","figure_required":false,"lesson_subtopic":"Volume and surface area","source_document":"test_6.pdf","source_question":167,"difficulty_basis":"Estimated solution complexity; not psychometrically calibrated.","verified_release":"20261030-act2-completed-review","curriculum_lesson":"Volume and surface area","source_archive_id":"ACT2-IMPORT-20261030-D20-P070-Q167","source_document_id":"act2-20261029-8ce5beb14b467975","source_question_id":"ACT2-IMPORT-20261030-D20-P070-Q167","verification_batch":"20261030-act2-completed-review","source_image_sha256":"f662d2d8d0e7296de5d64ed86c9e8509a00663a78b6c14887036123cb9a7c63b","answer_review_status":"independently_solved","classification_status":"reviewed"},"created_at":"2026-10-30 09:17:05.359989+00","key_row":{"correct":"B","explanation":"Write $r=5k,h=7k$. Then $550=(22/7)(25k^2)(7k)=550k^3$, so $k=1$ and $r=5$.","question_id":"015afa55-5485-5f8e-8925-5d6abe52776f"},"row_hash":"48a30f300794703603e0d62cfb34cae4","key_hash":"b93a49c1e5aca6ce4235dacf16e0f54a"}]
